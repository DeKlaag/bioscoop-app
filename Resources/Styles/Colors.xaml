<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- Kine palette — Material 3 dark theme (warm amber on charcoal) -->
    <!-- Mirrors the tailwind config used in the Kine web prototype.   -->
    <!-- ============================================================ -->

    <!-- Primary (warm amber) -->
    <Color x:Key="Primary">#ffc880</Color>
    <Color x:Key="OnPrimary">#452b00</Color>
    <Color x:Key="PrimaryContainer">#f5a623</Color>
    <Color x:Key="OnPrimaryContainer">#644000</Color>
    <Color x:Key="PrimaryFixed">#ffddb4</Color>
    <Color x:Key="PrimaryFixedDim">#ffb955</Color>
    <Color x:Key="OnPrimaryFixed">#291800</Color>
    <Color x:Key="OnPrimaryFixedVariant">#633f00</Color>
    <Color x:Key="InversePrimary">#835500</Color>
    <Color x:Key="SurfaceTint">#ffb955</Color>

    <!-- Secondary (cool neutral) -->
    <Color x:Key="Secondary">#c8c5ca</Color>
    <Color x:Key="OnSecondary">#303033</Color>
    <Color x:Key="SecondaryContainer">#47464a</Color>
    <Color x:Key="OnSecondaryContainer">#b7b4b8</Color>
    <Color x:Key="SecondaryFixed">#e4e1e6</Color>
    <Color x:Key="SecondaryFixedDim">#c8c5ca</Color>
    <Color x:Key="OnSecondaryFixed">#1b1b1e</Color>
    <Color x:Key="OnSecondaryFixedVariant">#47464a</Color>

    <!-- Tertiary -->
    <Color x:Key="Tertiary">#d3d0d7</Color>
    <Color x:Key="OnTertiary">#303035</Color>
    <Color x:Key="TertiaryContainer">#b7b5bc</Color>
    <Color x:Key="OnTertiaryContainer">#47474c</Color>
    <Color x:Key="TertiaryFixed">#e4e1e8</Color>
    <Color x:Key="TertiaryFixedDim">#c8c5cc</Color>
    <Color x:Key="OnTertiaryFixed">#1b1b20</Color>
    <Color x:Key="OnTertiaryFixedVariant">#47464c</Color>

    <!-- Error -->
    <Color x:Key="Error">#ffb4ab</Color>
    <Color x:Key="OnError">#690005</Color>
    <Color x:Key="ErrorContainer">#93000a</Color>
    <Color x:Key="OnErrorContainer">#ffdad6</Color>

    <!-- Background & surface -->
    <Color x:Key="Background">#121415</Color>
    <Color x:Key="OnBackground">#e2e2e3</Color>
    <Color x:Key="Surface">#121415</Color>
    <Color x:Key="OnSurface">#e2e2e3</Color>
    <Color x:Key="SurfaceVariant">#333536</Color>
    <Color x:Key="OnSurfaceVariant">#d7c3ae</Color>
    <Color x:Key="SurfaceDim">#121415</Color>
    <Color x:Key="SurfaceBright">#38393a</Color>
    <Color x:Key="SurfaceContainerLowest">#0c0e0f</Color>
    <Color x:Key="SurfaceContainerLow">#1a1c1d</Color>
    <Color x:Key="SurfaceContainer">#1e2021</Color>
    <Color x:Key="SurfaceContainerHigh">#282a2b</Color>
    <Color x:Key="SurfaceContainerHighest">#333536</Color>
    <Color x:Key="InverseSurface">#e2e2e3</Color>
    <Color x:Key="InverseOnSurface">#2f3132</Color>

    <!-- Outline -->
    <Color x:Key="Outline">#9f8e7a</Color>
    <Color x:Key="OutlineVariant">#524534</Color>

    <!-- ============================================================ -->
    <!-- Backwards-compatible aliases used by the existing Styles.xaml -->
    <!-- ============================================================ -->

    <Color x:Key="PrimaryDark">#ffc880</Color>
    <Color x:Key="PrimaryDarkText">#452b00</Color>
    <Color x:Key="SecondaryDarkText">#ffc880</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#ffc880</Color>
    <Color x:Key="MidnightBlue">#121415</Color>
    <Color x:Key="OffBlack">#121415</Color>

    <!-- Neutral ramp re-tuned to the Kine surfaces so existing
         Gray*-based bindings still feel cohesive with the new theme. -->
    <Color x:Key="Gray100">#e2e2e3</Color>
    <Color x:Key="Gray200">#c8c5ca</Color>
    <Color x:Key="Gray300">#9f8e7a</Color>
    <Color x:Key="Gray400">#7a7a7d</Color>
    <Color x:Key="Gray500">#524534</Color>
    <Color x:Key="Gray600">#47464a</Color>
    <Color x:Key="Gray900">#1e2021</Color>
    <Color x:Key="Gray950">#0c0e0f</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainer}"/>
    <SolidColorBrush x:Key="PrimaryFixedBrush" Color="{StaticResource PrimaryFixed}"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondary}"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainer}"/>

    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiary}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLow}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainer}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHigh}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighest}"/>

    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariant}"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainer}"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
