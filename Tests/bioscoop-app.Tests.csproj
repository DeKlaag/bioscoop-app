<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>bioscoop_app.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      The main project is a .NET MAUI app and can only be built with the MAUI
      workload (and on its target platforms). To keep these unit tests buildable
      and runnable on a plain .NET SDK / CI runner, we compile the specific
      production sources under test directly. Every file listed here is free of
      MAUI dependencies; it only uses System.* and the project's own models.
    -->
    <ItemGroup>
        <Compile Include="..\Models\MovieModel.cs" Link="Production\MovieModel.cs" />
        <Compile Include="..\Models\ReservationModel.cs" Link="Production\ReservationModel.cs" />
        <Compile Include="..\Services\IMovieService.cs" Link="Production\IMovieService.cs" />
        <Compile Include="..\Services\IFavoritesService.cs" Link="Production\IFavoritesService.cs" />
        <Compile Include="..\Services\IRecommendationService.cs" Link="Production\IRecommendationService.cs" />
        <Compile Include="..\Services\RecommendationService.cs" Link="Production\RecommendationService.cs" />
    </ItemGroup>

</Project>
