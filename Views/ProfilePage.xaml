<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bioscoop_app.Views.ProfilePage"
             Shell.TabBarIsVisible="False"
             Title="Profiel">
    <Shell.TitleView>
        <ContentView />
    </Shell.TitleView>
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,32" Spacing="24">

                <!-- Profile header -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <!-- Circular avatar with initial fallback -->
                    <Border HeightRequest="112"
                            WidthRequest="112"
                            HorizontalOptions="Center"
                            StrokeThickness="2"
                            Stroke="{StaticResource Primary}"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            StrokeShape="RoundRectangle 56">
                        <Grid>
                            <Label x:Name="InitialLbl"
                                   Text=""
                                   FontSize="44"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image x:Name="UserPictureImg"
                                   SemanticProperties.Description="Profielfoto"
                                   Aspect="AspectFill" />
                        </Grid>
                    </Border>

                    <Label x:Name="UsernameLbl"
                           Text=""
                           SemanticProperties.HeadingLevel="Level2"
                           SemanticProperties.Description="Naam van gebruiker"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />

                    <Label x:Name="EmailLbl"
                           Text=""
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Menu card -->
                <Border StrokeThickness="1"
                        Stroke="{StaticResource SurfaceContainerHigh}"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="0">

                        <!-- Check-in scanner -->
                        <Grid Padding="16,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckInScannerClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Check-in scanner"
                                   FontSize="16" VerticalOptions="Center"
                                   TextColor="{StaticResource OnSurface}" />
                            <Label Grid.Column="1" Text="›" FontSize="22"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainerHigh}" />

                        <!-- Meldingen -->
                        <Grid Padding="16,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationPreferencesClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Meldingen"
                                   FontSize="16" VerticalOptions="Center"
                                   TextColor="{StaticResource OnSurface}" />
                            <Label Grid.Column="1" Text="›" FontSize="22"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainerHigh}" />

                        <!-- Feedback -->
                        <Grid Padding="16,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeedbackClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Feedback geven"
                                   FontSize="16" VerticalOptions="Center"
                                   TextColor="{StaticResource OnSurface}" />
                            <Label Grid.Column="1" Text="›" FontSize="22"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Logout -->
                <Button
                    x:Name="LogoutBtn"
                    Text="Uitloggen"
                    SemanticProperties.Hint="Klik om uit te loggen"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Error}"
                    BorderColor="{StaticResource Error}"
                    BorderWidth="1" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
